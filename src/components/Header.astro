---
import { locales, type Locale } from '../i18n/ui';
import { localizePath, navItems, routes, useTranslations } from '../i18n/utils';
import Icon from './Icon.astro';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const t = useTranslations(locale);

const homeHref = localizePath(routes.home, locale);
const actionHref = localizePath(routes.contact, locale);
const shortNames: Record<Locale, string> = {
  en: t('lang.short.en'),
  zh: t('lang.short.zh'),
};

const links = navItems.map((item) => ({
  key: item.key,
  href: localizePath(item.path, locale),
}));
---

<header class="site-head">
  <div class="wrap site-head__row">
    <a class="site-head__brand" href={homeHref}><svg class="brand-mark" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M5 4h7v9h8V4h7v24h-7v-9h-8v9H5z" fill="currentColor" /></svg>{t('site.name')}</a>

    <nav class="site-head__nav" aria-label={t('nav.primary')}>
      <ul class="site-head__list">
        {
          links.map((link) => (
            <li>
              <a class="link" href={link.href} aria-current={link.href === currentPath ? 'page' : undefined}>
                {t(link.key)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="site-head__lang" aria-label={t('lang.label')}>
      {
        locales.map((candidate) => (
          <a
            href={localizePath(currentPath, candidate)}
            hreflang={candidate}
            aria-current={candidate === locale ? 'true' : undefined}
            title={candidate === locale ? t('lang.current') : t('lang.switchTo')}
          >
            {shortNames[candidate]}
          </a>
        ))
      }
    </nav>

    <a class="btn site-head__action" href={actionHref}>{t('hero.action')}<Icon name="arrow" /></a>

    <details class="site-head__menu">
      <summary>{t('nav.openMenu')}</summary>
      <div class="site-head__panel">
        <ul class="site-head__panel-list">
          {
            links.map((link) => (
              <li>
                <a href={link.href} aria-current={link.href === currentPath ? 'page' : undefined}>
                  {t(link.key)}
                </a>
              </li>
            ))
          }
        </ul>

        <p class="site-head__panel-lang">
          {
            locales.map((candidate) => (
              <a
                href={localizePath(currentPath, candidate)}
                hreflang={candidate}
                aria-current={candidate === locale ? 'true' : undefined}
              >
                {shortNames[candidate]}
              </a>
            ))
          }
        </p>

        <a class="btn site-head__panel-action" href={actionHref}>{t('hero.action')}</a>
      </div>
    </details>
  </div>
</header>
