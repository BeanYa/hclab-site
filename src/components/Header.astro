---
import { locales, type Locale } from '../i18n/ui';
import { localizePath, navItems, routes, useTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const t = useTranslations(locale);

const shortNames: Record<Locale, string> = {
  en: t('lang.short.en'),
  zh: t('lang.short.zh'),
};

const homeHref = localizePath(routes.home, locale);
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href={homeHref}>
      <img class="brand__mark" src="/favicon.svg" alt="" width="26" height="26" />
      <span class="brand__text">
        <span class="brand__name">{t('site.name')}</span>
        <span class="brand__descriptor">{t('brand.descriptor')}</span>
      </span>
    </a>

    <nav class="nav" aria-label={t('nav.primary')}>
      <ul class="nav__list">
        {
          navItems.map((item) => {
            const href = localizePath(item.path, locale);
            return (
              <li>
                <a class="nav__link" href={href} aria-current={href === currentPath ? 'page' : undefined}>
                  {t(item.key)}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <nav class="lang" aria-label={t('lang.label')}>
      {
        locales.map((candidate, index) => {
          const href = localizePath(currentPath, candidate);
          return (
            <>
              {index > 0 && <span class="lang__sep" aria-hidden="true">/</span>}
              <a
                class="lang__link"
                href={href}
                hreflang={candidate}
                aria-current={candidate === locale ? 'true' : undefined}
                title={candidate === locale ? t('lang.current') : t('lang.switchTo')}
              >
                {shortNames[candidate]}
              </a>
            </>
          );
        })
      }
    </nav>

    <details class="mobile-nav">
      <summary class="mobile-nav__summary">{t('nav.openMenu')}</summary>
      <div class="mobile-nav__panel">
        <ul class="mobile-nav__list">
          {
            navItems.map((item) => {
              const href = localizePath(item.path, locale);
              return (
                <li>
                  <a
                    class="mobile-nav__link"
                    href={href}
                    aria-current={href === currentPath ? 'page' : undefined}
                  >
                    {t(item.key)}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </div>
    </details>
  </div>
</header>
