---
import type { Locale, UIKey } from '../../i18n/ui';
import ReachField from '../ReachField.astro';
import Chooser from '../sections/Chooser.astro';
import ClipBand from '../sections/ClipBand.astro';
import PhotoBand from '../sections/PhotoBand.astro';
import { mailto, useTranslations, type DetailRow } from '../../i18n/utils';
import bridge from '../../assets/shenzhen-bay-bridge.jpg';
import panorama from '../../assets/shenzhen-panorama.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const email = t('contact.email.value');

const enquiryKeys = [
  'contact.enquiry.item1',
  'contact.enquiry.item2',
  'contact.enquiry.item3',
  'contact.enquiry.item4',
] as const satisfies readonly UIKey[];

const details: readonly DetailRow[] = [
  { label: 'contact.details.legal.label', value: 'contact.details.legal.value' },
  { label: 'contact.details.location.label', value: 'contact.details.location.value' },
  { label: 'contact.details.languages.label', value: 'contact.details.languages.value' },
  { label: 'contact.details.person.label', value: 'contact.person.value' },
  { label: 'contact.email.label', value: 'contact.email.value' },
];

const duo = [
  { src: bridge, alt: t('bridge.alt'), caption: t('bridge.caption'), credit: 'bridge' as const },
  {
    src: panorama,
    alt: t('band.panorama.alt'),
    caption: t('band.panorama.caption'),
    credit: 'panorama' as const,
  },
];
---

<section class="page-head">
  <div class="wrap grid">
    <h1 class="page-head__title rise">{t('contact.heading')}</h1>
    <p class="page-head__lede">{t('contact.lede')}</p>
    <p class="page-head__action">
      <a class="btn" href={mailto(email, t('contact.email.subject'))}>{t('contact.email.action')}</a>
    </p>
  </div>
</section>

<section class="section">
  <div class="wrap grid">
    <div class="prose prose--left rise">
      <h2>{t('contact.enquiry.title')}</h2>
      <ul class="enquiry">
        {enquiryKeys.map((key) => <li class="rise">{t(key)}</li>)}
      </ul>
    </div>

    <div class="prose rise">
      <h2>{t('contact.promise.title')}</h2>
      <p>{t('contact.promise.body')}</p>
    </div>
  </div>
</section>

<Chooser locale={locale} />

<section class="section" aria-labelledby="details-heading">
  <div class="wrap grid">
    <div class="proof__tables rise">
      <table class="ptable">
        <caption id="details-heading">
          {t('contact.details.title')}
        </caption>
        <thead>
          <tr>
            <th scope="col">{t('about.record.col1')}</th>
            <th scope="col">{t('about.record.col2')}</th>
          </tr>
        </thead>
        <tbody>
          {
            details.map((row) => (
              <tr>
                <td>{t(row.label)}</td>
                <td>{t(row.value)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<PhotoBand pictures={duo} locale={locale} />

<ClipBand locale={locale} />

<ReachField locale={locale} />
