---
import type { Locale } from '../../i18n/ui';
import ReachField from '../ReachField.astro';
import ClipBand from '../sections/ClipBand.astro';
import PhotoBand from '../sections/PhotoBand.astro';
import { commitmentIndexes, useTranslations, type DetailRow } from '../../i18n/utils';
import bridge from '../../assets/shenzhen-bay-bridge.jpg';
import civic from '../../assets/shenzhen-civic-center.jpg';
import panorama from '../../assets/shenzhen-panorama.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const principles = commitmentIndexes.map((index) => ({
  title: t(`about.principles.item${index}.title`),
  body: t(`about.principles.item${index}.body`),
}));

const record: readonly DetailRow[] = [
  { label: 'about.record.legal.label', value: 'about.record.legal.value' },
  { label: 'about.record.business.label', value: 'about.record.business.value' },
  { label: 'about.record.base.label', value: 'about.record.base.value' },
  { label: 'about.record.languages.label', value: 'about.record.languages.value' },
];

const duo = [
  { src: bridge, alt: t('bridge.alt'), caption: t('bridge.caption'), credit: 'bridge' as const },
  { src: civic, alt: t('civic.alt'), caption: t('civic.caption'), credit: 'civic' as const },
];

const single = [
  {
    src: panorama,
    alt: t('band.panorama.alt'),
    caption: t('band.panorama.caption'),
    credit: 'panorama' as const,
  },
];
---

<section class="page-head">
  <div class="wrap grid">
    <h1 class="page-head__title rise">{t('about.title')}</h1>
    <p class="page-head__lede">{t('about.lede')}</p>
  </div>
</section>

<section class="section" aria-labelledby="profile-heading">
  <div class="wrap grid">
    <div class="prose rise">
      <h2 id="profile-heading">{t('about.profile.title')}</h2>
      <p>{t('about.profile.body1')}</p>
      <p>{t('about.profile.body2')}</p>
    </div>
  </div>
</section>

<PhotoBand pictures={duo} locale={locale} />

<section class="section field-tone" aria-labelledby="principles-heading">
  <div class="wrap grid">
    <div class="proof__head rise">
      <h2 class="proof__heading" id="principles-heading">{t('about.principles.title')}</h2>
      <p class="proof__lede">{t('about.principles.lede')}</p>
    </div>

    <div class="commitments">
      {
        principles.map((principle) => (
          <article class="commitment rise">
            <h3 class="commitment__title">{principle.title}</h3>
            <p class="commitment__body">{principle.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section class="section" aria-labelledby="record-heading">
  <div class="wrap grid">
    <div class="proof__tables rise">
      <table class="ptable">
        <caption id="record-heading">
          {t('about.record.title')}
        </caption>
        <thead>
          <tr>
            <th scope="col">{t('about.record.col1')}</th>
            <th scope="col">{t('about.record.col2')}</th>
          </tr>
        </thead>
        <tbody>
          {
            record.map((row) => (
              <tr>
                <td>{t(row.label)}</td>
                <td>{t(row.value)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>

<PhotoBand pictures={single} locale={locale} />

<ClipBand locale={locale} />

<ReachField locale={locale} />
