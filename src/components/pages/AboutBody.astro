---
import type { Locale, UIKey } from '../../i18n/ui';
import { localizePath, principleIndexes, routes, useTranslations } from '../../i18n/utils';
import CtaBand from '../CtaBand.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

interface Fact {
  label: UIKey;
  value: string;
}

const facts: readonly Fact[] = [
  { label: 'about.facts.legal.label', value: t('about.facts.legal.value') },
  { label: 'about.facts.business.label', value: t('about.facts.business.value') },
  { label: 'about.facts.base.label', value: t('about.facts.base.value') },
  { label: 'about.facts.languages.label', value: t('about.facts.languages.value') },
  // Composed from the contact keys so the mailbox keeps a single source of truth.
  {
    label: 'about.facts.contact.label',
    value: `${t('contact.person.value')} · ${t('contact.email.value')}`,
  },
];

const principles = principleIndexes.map((index) => ({
  title: t(`about.principles.item${index}.title`),
  body: t(`about.principles.item${index}.body`),
}));
---

<section class="page-head">
  <div class="wrap">
    <p class="eyebrow">{t('about.eyebrow')}</p>
    <h1 class="page-head__title">{t('about.title')}</h1>
    <p class="page-head__lede">{t('about.lede')}</p>
  </div>
</section>

<section class="section">
  <div class="wrap split">
    <div class="prose">
      <h2>{t('about.profile.title')}</h2>
      <p>{t('about.profile.body1')}</p>
      <p>{t('about.profile.body2')}</p>
      <p>
        <a class="btn btn--ghost" href={localizePath(routes.services, locale)}>
          {t('nav.services')}
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
      </p>
    </div>

    <div>
      <h2 class="eyebrow">{t('about.facts.title')}</h2>
      <dl class="facts facts--stacked">
        {
          facts.map((fact) => (
            <div class="facts__row">
              <dt class="facts__key">{t(fact.label)}</dt>
              <dd class="facts__value">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<section class="section reveal" aria-labelledby="principles-heading">
  <div class="wrap">
    <div class="section__head">
      <p class="eyebrow">{t('about.principles.eyebrow')}</p>
      <h2 class="section__title" id="principles-heading">{t('about.principles.title')}</h2>
    </div>

    <div class="principles">
      {
        principles.map((principle, index) => (
          <article class="principle">
            <p class="principle__index" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </p>
            <h3 class="principle__title">{principle.title}</h3>
            <p class="principle__body">{principle.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<CtaBand locale={locale} />
