---
import type { Locale } from '../../i18n/ui';
import ReachField from '../ReachField.astro';
import Chooser from '../sections/Chooser.astro';
import Hero from '../sections/Hero.astro';
import Intro from '../sections/Intro.astro';
import Process from '../sections/Process.astro';
import Proof from '../sections/Proof.astro';
import ServicesSplit from '../sections/ServicesSplit.astro';
interface Props { locale: Locale; }
const { locale } = Astro.props;
---
<Hero locale={locale} />
<ServicesSplit locale={locale} />
<Proof locale={locale} />
<Process locale={locale} />
<Chooser locale={locale} />
<Intro locale={locale} />
<ReachField locale={locale} />
