---
import { Image } from 'astro:assets';
import type { Locale } from '../../i18n/ui';
import ReachField from '../ReachField.astro';
import ClipBand from '../sections/ClipBand.astro';
import PhotoBand from '../sections/PhotoBand.astro';
import { creditHrefs, getServices, useTranslations } from '../../i18n/utils';
import civic from '../../assets/shenzhen-civic-center.jpg';
import futian from '../../assets/shenzhen-futian.jpg';
import market from '../../assets/huaqiangbei-electronics-market.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const services = getServices(locale);

/**
 * One chop per service: the six kinds of work as six printed marks, cycling
 * the three inks. Geometry only.
 */
const chops = [
  '<circle cx="12" cy="12" r="10" class="ink-pink" />',
  '<polygon points="12,2 22,22 2,22" class="ink-blue" />',
  '<path d="M2 12 A10 10 0 0 1 22 12 Z" class="ink-sunflower" />',
  '<rect x="4.5" y="4.5" width="15" height="15" class="ink-line-pink" transform="rotate(45 12 12)" />',
  '<circle cx="12" cy="12" r="9.5" class="ink-line-blue" />',
  '<polygon points="12,3 21.5,21 2.5,21" class="ink-line-sunflower" />',
] as const;

const duo = [
  { src: market, alt: t('live.picture.alt'), caption: t('live.picture.caption'), credit: 'market' as const },
  { src: civic, alt: t('civic.alt'), caption: t('civic.caption'), credit: 'civic' as const },
];
---

<section class="page-head">
  <div class="wrap grid">
    <h1 class="page-head__title rise">{t('servicesPage.title')}</h1>
    <p class="page-head__lede">{t('servicesPage.lede')}</p>
  </div>
</section>

<section class="section" aria-label={t('servicesPage.title')}>
  <div class="wrap">
    {
      services.map((service, index) => (
        <article class="svc rise">
          <div class="svc__row">
            <svg class="svc__chop" viewBox="0 0 24 24" aria-hidden="true" set:html={chops[index]} />
            <h2 class="svc__title">{service.title}</h2>
            <p class="svc__summary">{service.summary}</p>
            <ul class="svc__terms">
              {service.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</section>

<section class="section" aria-labelledby="engagement-heading">
  <div class="wrap grid">
    <div class="prose prose--left rise">
      <h2 id="engagement-heading">{t('servicesPage.engagement.title')}</h2>
      <p>{t('servicesPage.engagement.body')}</p>
    </div>

    <figure class="proof__figure rise">
      <div class="band__cell">
        <Image
          src={futian}
          alt={t('proof.picture.alt')}
          widths={[420, 700, 1100]}
          sizes="(min-width: 62rem) 32vw, 100vw"
        />
      </div>
      <figcaption class="caption">
        {t('proof.picture.caption')}{t('sep.inline')}
        <a href={creditHrefs.futian} rel="noreferrer">{t('credit.futian')}</a>
      </figcaption>
    </figure>
  </div>
</section>

<PhotoBand pictures={duo} locale={locale} />

<section class="section" aria-labelledby="services-cta-heading">
  <div class="wrap grid">
    <div class="proof__head rise">
      <h2 class="proof__heading" id="services-cta-heading">{t('servicesPage.cta.title')}</h2>
      <p class="proof__lede">{t('servicesPage.cta.body')}</p>
    </div>
  </div>
</section>

<ClipBand locale={locale} />

<ReachField locale={locale} />
