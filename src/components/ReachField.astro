---
import type { Locale } from '../i18n/ui';
import { mailto, useTranslations } from '../i18n/utils';
import Icon from './Icon.astro';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);
const email = t('contact.email.value');
---
<section class="reach" aria-labelledby="reach-heading"><div class="wrap reach__inner">
  <div><p class="eyebrow">{t('nav.contact')}</p><h2 id="reach-heading"><span>{t('reach.title.a')}</span>{t('sep.inline')}<span>{t('reach.title.b')}</span></h2><p class="reach__note">{t('contact.lede')}</p></div>
  <div class="reach__action"><a class="btn" href={mailto(email, t('contact.email.subject'))}>{t('hero.action')}<Icon name="arrow" /></a><a class="reach__email" href={`mailto:${email}`}>{email}</a></div>
</div></section>