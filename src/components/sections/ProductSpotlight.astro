---
import { Image } from 'astro:assets';
import symbol from '../../assets/listenloop-symbol.png';
import type { Locale } from '../../i18n/ui';
import { localizePath, routes, useTranslations } from '../../i18n/utils';
import Icon from '../Icon.astro';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);
---
<section class="section product-spotlight" aria-labelledby="products-heading">
  <div class="wrap">
    <div class="section-head">
      <div><p class="eyebrow">{t('product.home.label')}</p><h2 id="products-heading"><span>{t('product.home.title.a')}</span>{t('sep.inline')}<span class="muted-heading">{t('product.home.title.b')}</span></h2></div>
      <p class="section-head__aside">{t('product.home.lede')}</p>
    </div>
    <article class="product-card">
      <div class="product-card__art">
        <Image src={symbol} alt={t('product.logo.alt')} widths={[240, 480]} sizes="(max-width: 600px) 200px, 300px" width={300} height={300} loading="lazy" />
        <p>{t('product.tagline')}</p>
      </div>
      <div class="product-card__copy">
        <p class="eyebrow">{t('product.category')}</p>
        <h3>{t('product.name')}</h3>
        <p class="product-card__summary">{t('product.summary')}</p>
        <ul class="product-tags"><li>{t('product.preview')}</li><li>{t('product.local')}</li></ul>
        <a class="text-link" href={localizePath(routes.listenloop, locale)}>{t('product.link')}<Icon name="arrow" /></a>
      </div>
    </article>
  </div>
</section>
