---
import type { Locale } from '../../i18n/ui';
import { getServices, localizePath, routes, useTranslations } from '../../i18n/utils';
import Icon, { type IconName } from '../Icon.astro';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);
const services = getServices(locale);
const icons: IconName[] = ['code', 'window', 'workflow', 'support', 'cloud', 'review'];
---
<section class="section expertise" id="expertise" aria-labelledby="services-heading">
  <div class="wrap">
    <div class="section-head">
      <div><p class="eyebrow">{t('section.services.label')}</p><h2 id="services-heading"><span>{t('services.heading.a')}</span>{t('sep.inline')}<span class="muted-heading">{t('services.heading.b')}</span></h2></div>
      <div class="section-head__aside"><p>{t('services.lede')}</p><a class="text-link" href={localizePath(routes.services, locale)}>{t('services.link')}<Icon name="arrow" /></a></div>
    </div>
    <div class="service-grid">
      {services.map((service, index) => (
        <a class:list={['service-card', 'service-card--' + service.slug]} href={localizePath(routes.services, locale) + '#' + service.slug}>
          <div class="service-card__top"><span class="service-card__icon"><Icon name={icons[index]!} /></span><Icon name="arrow" class="service-card__arrow" /></div>
          <h3>{service.title}</h3><p>{service.summary}</p>
          {index === 0 && <div class="product-sketch" aria-hidden="true"><div class="product-sketch__bar"><i></i><i></i><i></i></div><div class="product-sketch__body"><div class="product-sketch__nav"><i></i><i></i><i></i><i></i></div><div class="product-sketch__main"><div class="product-sketch__line"></div><div class="product-sketch__tiles"><i></i><i></i><i></i></div><svg viewBox="0 0 200 70" fill="none"><path d="M0 60 32 42 55 48 85 25 110 32 140 12 166 20 200 4" /></svg></div></div></div>}
          {index === 5 && <ul>{service.points.map(point => <li><Icon name="check" />{point}</li>)}</ul>}
        </a>
      ))}
    </div>
  </div>
</section>