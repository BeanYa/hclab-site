---
import { localeTags, type Locale, type UIKey } from '../../i18n/ui';
import { localizePath, routes, useTranslations } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/**
 * The hero prints only the reading locale's name (client decision
 * 2026-10-15); the other script's name stays in the DOM for screen readers
 * and search engines, marked with its own lang. The visible name carries a
 * ghost of itself — the second print pass, missed by a hair.
 */
const otherLocale = locale === 'zh' ? 'en' : 'zh';

const facts = [
  { label: 'hero.facts.work.label', value: 'hero.facts.work.value' },
  { label: 'hero.facts.support.label', value: 'hero.facts.support.value' },
  { label: 'hero.facts.based.label', value: 'hero.facts.based.value' },
  { label: 'hero.facts.languages.label', value: 'hero.facts.languages.value' },
] as const satisfies readonly { label: UIKey; value: UIKey }[];
---

<section class="hero">
  <div class="hero__spot" aria-hidden="true"></div>

  <div class="wrap hero__inner">
    <div class="hero__mark">
      <h1 class:list={['hero__name', { 'hero__name--han': locale === 'zh' }]}>
        <span class="misprint">
          <span class="misprint__ghost" aria-hidden="true">{t('hero.nameA')}</span>
          {t('hero.nameA')}
        </span>
        <span class="visually-hidden" lang={localeTags[otherLocale]}> {t('hero.nameB')}</span>
      </h1>
    </div>

    <div class="hero__foot">
      <p class="hero__support">{t('hero.support')}</p>

      <dl class="hero__facts">
        {
          facts.map((fact) => (
            <div>
              <dt>{t(fact.label)}</dt>
              <dd>{t(fact.value)}</dd>
            </div>
          ))
        }
      </dl>

      <a class="btn press" href={localizePath(routes.contact, locale)}>{t('hero.action')}</a>
    </div>
  </div>
</section>
