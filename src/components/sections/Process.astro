---
import type { Locale } from '../../i18n/ui';
import { processLines, useTranslations } from '../../i18n/utils';
import Icon, { type IconName } from '../Icon.astro';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);
const icons: IconName[] = ['review', 'layers', 'code', 'support'];
---
<section class="section process-section" aria-labelledby="process-heading">
  <div class="wrap">
    <div class="section-head"><div><p class="eyebrow">{t('section.process.label')}</p><h2 id="process-heading"><span>{t('section.process.title.a')}</span>{t('sep.inline')}<span class="muted-heading">{t('section.process.title.b')}</span></h2></div><p class="section-head__aside">{t('section.process.lede')}</p></div>
    <div class="process">{processLines.map((n) => <article class="process__step"><span class="process__icon"><Icon name={icons[n - 1]!} /></span><h3>{t(`process.line${n}`)}</h3><p>{t(`process.line${n}.body`)}</p></article>)}</div>
  </div>
</section>