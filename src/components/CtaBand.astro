---
import type { Locale, UIKey } from '../i18n/ui';
import { localizePath, routes, useTranslations } from '../i18n/utils';

interface Props {
  locale: Locale;
  titleKey?: UIKey;
  bodyKey?: UIKey;
}

const { locale, titleKey = 'cta.title', bodyKey = 'cta.body' } = Astro.props;
const t = useTranslations(locale);
---

<section class="cta-band">
  <div class="wrap cta-band__grid">
    <div>
      <h2 class="cta-band__title">{t(titleKey)}</h2>
      <p class="cta-band__body">{t(bodyKey)}</p>
    </div>
    <div class="cta-band__actions">
      <a class="btn btn--primary" href={localizePath(routes.contact, locale)}>
        {t('cta.button')}
        <span class="btn__arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
